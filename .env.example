# Copy to .env and fill in. .env is gitignored. Never commit keys.
# The AI provider, model and keys can also be set in the app (Settings), which saves them to
# $LIBRARY_DIR/settings.json (mode 600). Values saved there win over these.
GROQ_API_KEY=
# Other providers: MDM_PROVIDER is groq (default), anthropic, openai, google or compatible
# MDM_PROVIDER=
# MDM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# compatible: any OpenAI-compatible server, e.g. Ollama at http://localhost:11434/v1 (MDM_MODEL is then required)
# MDM_BASE_URL=
# Firecrawl runs locally (scripts/firecrawl_local.sh up). The key is only needed for a remote/cloud instance.
# In docker compose, FIRECRAWL_API_URL, MDM_CLI, LIBRARY_DIR, DOWNLOAD_DIR and DATA_DIR are overridden inside the container.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
# Optional: enables VirusTotal URL/hash reputation checks on preview cards
VIRUSTOTAL_API_KEY=
# Model served by Groq (MDM_MODEL wins when both are set)
GROQ_MODEL=openai/gpt-oss-120b
# MDM headless CLI. Leave unset to use the one built from the fork (scripts/build_mdm.sh),
# falling back to the prebuilt release (scripts/install_mdm.sh).
# MDM_CLI=
# parallel connections per http download (1-128); 16 is a good default
MDM_CONNECTIONS=16
# Library: mdm.db, files/ and posters/. Default ~/MDM Library (in Docker: ./library mounted at /library)
# LIBRARY_DIR=
# Remote access (Tailscale, see README). MDM_TOKEN is the login password: long and random, `openssl rand -hex 32`
# (failed logins are not rate limited). ALLOWED_HOSTS needs MDM_TOKEN: the machine's name, e.g. box.tailnet-1234.ts.net
# MDM_TOKEN=
# ALLOWED_HOSTS=
# Signs session cookies and stream links; default: generated once into the library's .secret
# MDM_SECRET=
# Optional DNS server for MDM's downloads (passed as --dns)
# MDM_DNS=
