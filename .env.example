# Copy to .env and fill in. .env is gitignored. Never commit keys.
GROQ_API_KEY=
# Firecrawl runs locally (scripts/firecrawl_local.sh up). The key is only needed for a remote/cloud instance.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
# Optional: enables VirusTotal URL/hash reputation checks on preview cards
VIRUSTOTAL_API_KEY=
# Model served by Groq
GROQ_MODEL=openai/gpt-oss-120b
# MDM headless CLI. Leave unset to use the one built from the fork (scripts/build_mdm.sh),
# falling back to the prebuilt release (scripts/install_mdm.sh).
# MDM_CLI=
DOWNLOAD_DIR=./downloads
# parallel connections per http download (1-128); 16 is a good default
MDM_CONNECTIONS=16
DATA_DIR=./data
